# Local Home Assistant Core URL (keep this origin-only; do not add /api).
EVERDASH_HA_URL=http://127.0.0.1:8123

# Create a long-lived access token in your local Home Assistant profile.
# Keep the actual value in the ignored .env.local file; never commit it.
EVERDASH_HA_TOKEN=replace-with-local-home-assistant-token

# Optional host name or IP for iPad access. Leave empty to detect an address.
EVERDASH_LAN_HOST=

# Optional persistent EverDash dashboard and paired-device data directory.
EVERDASH_DATA_DIR=.local/everdash
