{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "paths": {
      "@everdash/contracts/*": ["./packages/contracts/src/*"],
      "@/*": ["./apps/server/src/*"]
    },
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["./apps/server/src/**/*.ts", "packages/contracts/src/**/*.ts"]
}
