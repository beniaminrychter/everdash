{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["ES2017", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "paths": {
      "@everdash/contracts/*": ["./packages/contracts/src/*"],
      "@everdash/ui/*": ["./packages/ui/src/*"],
      "@everdash/dashboard/*": ["./packages/dashboard/src/*"],
      "@/*": ["./apps/tablet/src/*"]
    },
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"]
  },
  "include": [
    "apps/tablet/src",
    "packages",
    "preview",
    "tests/config.types.ts",
    "tests/canvasBoundary.types.ts",
    "vite.config.ts",
    "vite.preview.config.ts",
    "tooling/aliases.ts",
    "scripts/export-config.ts"
  ]
}
