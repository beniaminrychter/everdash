{
  "name": "everdash",
  "version": "0.2.2",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && vite build --config apps/admin/vite.config.ts && vite build --config vite.server.config.ts",
    "start": "EVERDASH_DATA_DIR=${EVERDASH_DATA_DIR:-.local/everdash} node dist-server/server.js",
    "reset-connection": "EVERDASH_DATA_DIR=${EVERDASH_DATA_DIR:-.local/everdash} tsx apps/server/src/entry.ts --reset-connection",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit && tsc -p apps/admin/tsconfig.json --noEmit && tsc -p tsconfig.server.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node --import tsx tests/browser.smoke.mjs && node tests/admin.browser.smoke.mjs",
    "check:compat": "node scripts/check-compat.mjs",
    "smoke:server": "node scripts/server-smoke.mjs",
    "config:export": "node --import tsx scripts/export-config.ts"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@preact/preset-vite": "^2.10.6",
    "@stale-styles/eslint-plugin": "^1.0.2",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-legacy": "^7.2.1",
    "acorn": "^8.15.0",
    "autoprefixer": "^10.4.21",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.6",
    "terser": "^5.44.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "ultracite": "^8.0.1",
    "vite": "^7.2.0"
  },
  "browserslist": [
    "ios_saf >= 12",
    "Safari >= 12"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
