{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"]
  },
  "include": [
    "src",
    "vite.config.ts",
    "../src/shared/config/types.ts",
    "../src/shared/config/validate.ts",
    "../src/shared/config/normalize.ts",
    "../src/shared/ui/iconNames.ts"
  ]
}
