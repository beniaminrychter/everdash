{
  "name": "everdash",
  "version": "0.2.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:admin": "vite --config admin/vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "typecheck:admin": "tsc -p admin/tsconfig.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "build:server": "vite build --config vite.server.config.ts",
    "build:tablet": "npm run typecheck && vite build",
    "build:admin": "npm run typecheck:admin && vite build --config admin/vite.config.ts",
    "build:preview": "vite build --config vite.preview.config.ts",
    "build:local-server": "npm run typecheck:server && vite build --config vite.local-server.config.ts",
    "local:start": "node --import tsx scripts/check-local-env.mjs && npm run build && npm run build:server && npm run build:local-server && node --env-file=.env.local dist-local-server/local-server.js",
    "local:ha:up": "node scripts/local-docker.mjs compose -f compose.local.yaml up -d",
    "local:ha:down": "node scripts/local-docker.mjs compose -f compose.local.yaml down",
    "local:ha:logs": "node scripts/local-docker.mjs compose -f compose.local.yaml logs -f",
    "smoke:server": "node scripts/server-smoke.mjs",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "format": "ultracite fix",
    "format:check": "oxfmt --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run typecheck:admin && npm test",
    "build": "npm run build:tablet && npm run build:admin && npm run build:preview",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node --import tsx tests/browser.smoke.mjs",
    "test:admin-browser": "node tests/admin.browser.smoke.mjs",
    "config:export": "node --import tsx scripts/export-config.ts",
    "check:compat": "node scripts/check-compat.mjs"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@playwright/test": "^1.56.0",
    "@preact/preset-vite": "^2.10.6",
    "@stale-styles/eslint-plugin": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-react": "^5.2.0",
    "acorn": "^8.15.0",
    "autoprefixer": "^10.4.21",
    "lucide-react": "^1.59.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "terser": "^5.44.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "ultracite": "^8.0.1",
    "vite": "^7.2.0"
  },
  "browserslist": [
    "ios_saf >= 12",
    "Safari >= 12"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
